# Providers: "mock" works fully offline. "serpapi" requires SERPAPI_KEY.
RATES_PROVIDER=mock

# Google Maps Platform. Leave empty to use offline mock places/routes + fallback map.
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional Map ID for Advanced Markers (defaults to Google's DEMO_MAP_ID)
NEXT_PUBLIC_GOOGLE_MAP_ID=

SERPAPI_KEY=

# LLM enrichment + NL query parsing. Leave empty to use keyword heuristics.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Optional persistence. Without these, in-memory caches are used.
DATABASE_URL=
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=
